worker_processes auto;
events { worker_connections 4096; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  server_tokens off;

  # Adresse réelle du navigateur : le load balancer ajoute « client, adresse du LB ».
  set_real_ip_from ${PROXY_CIDR};
  set_real_ip_from ${LB_PUBLIC_IP};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  log_format json escape=json '{"time":"$time_iso8601","requestId":"$request_id","method":"$request_method",'
    '"path":"$uri","status":$status,"durationSeconds":$request_time,"client":"$remote_addr"}';
  access_log /var/log/nginx/access.log json;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  limit_req_zone $binary_remote_addr zone=authentification:10m rate=20r/m;
  limit_req_status 429;

  upstream api { server api:3000; keepalive 32; }
  # Signalisation des conférences : API des SFU, joignable des seules VM applicatives (FW6).
  upstream livekit {
    server ${SFU_1_HOST}:7880;
    server ${SFU_2_HOST}:7880;
  }

  server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;

    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    # Une API arrêtée ne doit pas faire attendre le navigateur une minute.
    proxy_connect_timeout 3s;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;

    # Passerelle : la session est vérifiée avant tout accès à l'API. L'API la revérifie et
    # garde les décisions de droits ; elle ne fait pas confiance aux en-têtes du client.
    location = /_session {
      internal;
      proxy_pass http://api/internal/auth/session;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
    }
    location @session_requise {
      default_type application/json;
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options nosniff always;
      return 401 '{"code":"UNAUTHORIZED","message":"Authentification requise","requestId":"$request_id"}';
    }

    location = /healthz-edge { access_log off; proxy_pass http://api/readyz; }

    # Preuve ACME du certificat public, relayée à la VM de supervision.
    location /.well-known/acme-challenge/ { proxy_pass http://${ACME_UPSTREAM}:8080; }

    location = /api/v1/ws {
      auth_request /_session;
      error_page 401 = @session_requise;
      proxy_pass http://api;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Request-ID $request_id;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
    location ~ ^/api/v1/auth/(login|register)$ {
      limit_req zone=authentification burst=10 nodelay;
      proxy_pass http://api;
    }
    location /api/v1/ {
      auth_request /_session;
      error_page 401 = @session_requise;
      proxy_pass http://api;
    }
    # Seules les routes v1 sont publiques ; /metrics ne l'est jamais.
    location /api/ { return 404; }
    location = /metrics { return 404; }

    location /livekit/ {
      proxy_pass http://livekit/;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    # Le navigateur doit voir chaque nouvelle version du service worker.
    location = /sw.js {
      root /usr/share/nginx/html;
      add_header Cache-Control "no-cache" always;
      add_header X-Content-Type-Options nosniff always;
    }

    location / {
      root /usr/share/nginx/html;
      try_files $uri $uri/ /index.html;
    }
  }
}
