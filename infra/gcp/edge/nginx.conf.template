worker_processes auto;
# Les erreurs courantes peuvent inclure la requête brute.
error_log /dev/stderr crit;
events { worker_connections 4096; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  server_tokens off;

  # Adresse réelle du navigateur : le load balancer ajoute « client, adresse du LB ».
  set_real_ip_from ${PROXY_CIDR};
  set_real_ip_from ${LB_PUBLIC_IP};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # Le format UUID garde les mêmes identifiants dans l'erreur et le journal.
  map $request_id $request_uuid {
    "~^(?<uuid_a>[0-9a-f]{8})(?<uuid_b>[0-9a-f]{4})[0-9a-f](?<uuid_c>[0-9a-f]{3})[0-9a-f](?<uuid_d>[0-9a-f]{3})(?<uuid_e>[0-9a-f]{12})$"
      $uuid_a-$uuid_b-4$uuid_c-a$uuid_d-$uuid_e;
  }
  map $request_method $safe_method {
    default other;
    GET GET; POST POST; PUT PUT; PATCH PATCH; DELETE DELETE; HEAD HEAD; OPTIONS OPTIONS;
  }
  log_format json escape=json '{"time":"$time_iso8601","requestId":"$request_uuid","method":"$safe_method",'
    '"status":$status,"durationSeconds":$request_time}';
  access_log /var/log/nginx/access.log json;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  limit_req_zone $binary_remote_addr zone=authentification:10m rate=20r/m;
  limit_req_status 429;

  upstream api { server api:3000; keepalive 32; }
  # Signalisation des conférences : API des SFU, joignable des seules VM applicatives (FW6).
  upstream livekit {
    server ${SFU_1_HOST}:7880;
    server ${SFU_2_HOST}:7880;
  }

  server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;

    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    # Une API arrêtée ne doit pas faire attendre le navigateur une minute.
    proxy_connect_timeout 3s;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_uuid;
    # L'identité vient de la vérification de session, jamais du navigateur.
    set $chat_user "";
    proxy_set_header X-User-Id $chat_user;
    proxy_set_header X-Session-Id "";
    # La limite de débit peut s'appliquer après une première redirection interne.
    recursive_error_pages on;
    error_page 429 = @trop_de_requetes;

    # Passerelle : la session est vérifiée avant tout accès à l'API. L'API la revérifie et
    # garde les décisions de droits ; elle ne fait pas confiance aux en-têtes du client.
    location = /_session {
      internal;
      proxy_pass http://api/internal/auth/verify;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_uuid;
    }
    location @session_requise {
      default_type application/json;
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options nosniff always;
      return 401 '{"code":"UNAUTHORIZED","message":"Authentification requise","requestId":"$request_uuid"}';
    }
    location @trop_de_requetes {
      default_type application/json;
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options nosniff always;
      return 429 '{"code":"RATE_LIMITED","message":"Trop de tentatives, patientez une minute","requestId":"$request_uuid"}';
    }

    location = /healthz-edge { access_log off; proxy_pass http://api/readyz; }
    # État public : « le service répond », sans autre information.
    location = /healthz { proxy_pass http://api; }
    location = /readyz { proxy_pass http://api; }

    # Lecteur d'architecture : seuls ces fichiers sont publiés.
    location = /architecture { return 308 https://$host/architecture/; }
    location /architecture/ { return 404; }
    location ~ ^/architecture/(index\.html|lecteur\.js|svg/[a-z0-9-]+\.svg)?$ {
      root /usr/share/nginx;
      index index.html;
    }

    # Preuve ACME du certificat public, relayée à la VM de supervision.
    location /.well-known/acme-challenge/ { proxy_pass http://${ACME_UPSTREAM}:8080; }

    location = /api/v1/ws {
      auth_request /_session;
      auth_request_set $chat_user $upstream_http_x_user_id;
      error_page 401 = @session_requise;
      proxy_pass http://api;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Request-ID $request_uuid;
      proxy_set_header X-User-Id $chat_user;
      proxy_set_header X-Session-Id "";
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
    # Seules routes publiques : créer un compte et ouvrir une session, à débit limité.
    location = /api/v1/sessions {
      limit_req zone=authentification burst=10 nodelay;
      proxy_pass http://api;
    }
    location = /api/v1/users {
      error_page 418 = @inscription;
      error_page 401 = @session_requise;
      # « return » précède le contrôle d'accès : la recherche (GET) reste protégée.
      if ($request_method = POST) { return 418; }
      auth_request /_session;
      auth_request_set $chat_user $upstream_http_x_user_id;
      proxy_pass http://api;
    }
    location @inscription {
      limit_req zone=authentification burst=10 nodelay;
      proxy_pass http://api;
    }
    location /api/v1/ {
      auth_request /_session;
      auth_request_set $chat_user $upstream_http_x_user_id;
      error_page 401 = @session_requise;
      proxy_pass http://api;
    }
    # Seules les routes v1 sont publiques ; /metrics ne l'est jamais.
    location /api/ { return 404; }
    location = /metrics { return 404; }

    location = /livekit { return 404; }
    location /livekit/ { return 404; }
    location ~ ^/livekit/rtc(/validate)?$ {
      rewrite ^/livekit(/rtc(/validate)?)$ $1 break;
      proxy_pass http://livekit;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    # Le navigateur doit voir chaque nouvelle version du service worker.
    location = /sw.js {
      root /usr/share/nginx/html;
      add_header Cache-Control "no-cache" always;
      add_header X-Content-Type-Options nosniff always;
    }

    location / {
      root /usr/share/nginx/html;
      try_files $uri $uri/ /index.html;
    }
  }
}
