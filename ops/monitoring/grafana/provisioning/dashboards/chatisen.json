{
  "uid": "chatisen",
  "title": "ChatISEN",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {"id": 18, "type": "table", "title": "Alertes Prometheus", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 6}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "ALERTS{alertstate=~\"pending|firing\"}", "instant": true, "range": false, "format": "table", "refId": "A"}], "transformations": [{"id": "organize", "options": {"excludeByName": {"__name__": true, "Time": true, "Value": true}, "indexByName": {"alertname": 0, "alertstate": 1, "gravite": 2, "instance": 3}, "renameByName": {"alertname": "Alerte", "alertstate": "État", "gravite": "Gravité", "instance": "Instance"}}}]},
    {"id": 1, "type": "timeseries", "title": "Cibles disponibles", "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "up", "legendFormat": "{{job}} · {{instance}}", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "Requêtes API par seconde", "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "targets": [{"expr": "sum by (instance) (rate(chatisen_http_requests_total[5m]))", "legendFormat": "{{instance}}", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Latence HTTP p95", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(chatisen_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "Erreurs HTTP par seconde", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "targets": [{"expr": "sum by (status) (rate(chatisen_http_requests_total{status=~\"[45]..\"}[5m]))", "legendFormat": "HTTP {{status}}", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Connexions WebSocket", "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "sum by (instance) (chatisen_ws_connections)", "legendFormat": "{{instance}}", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "Messages enregistrés par seconde", "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "sum(rate(chatisen_messages_total[5m]))", "legendFormat": "", "refId": "A"}]},
    {"id": 7, "type": "timeseries", "title": "Envoi → livraison WebSocket p95", "gridPos": {"x": 0, "y": 30, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(chatisen_message_delivery_seconds_bucket[5m])))", "legendFormat": "", "refId": "A"}]},
    {"id": 8, "type": "timeseries", "title": "Âge du plus ancien événement en attente", "gridPos": {"x": 12, "y": 30, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "max(chatisen_outbox_oldest_pending_seconds)", "legendFormat": "", "refId": "A"}]},
    {"id": 9, "type": "timeseries", "title": "Échecs, expirations et reprises Push par heure", "gridPos": {"x": 0, "y": 38, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "sum by (event) (increase(chatisen_push_events_total[1h]))", "legendFormat": "{{event}}", "refId": "A"}]},
    {"id": 10, "type": "timeseries", "title": "Appels à deux établis par heure", "gridPos": {"x": 12, "y": 38, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "sum by (route) (increase(chatisen_calls_established_total[1h]))", "legendFormat": "{{route}}", "refId": "A"}]},
    {"id": 11, "type": "timeseries", "title": "RTT des appels p95", "gridPos": {"x": 0, "y": 46, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(chatisen_call_rtt_milliseconds_bucket[5m])))", "legendFormat": "", "refId": "A"}]},
    {"id": 12, "type": "timeseries", "title": "Gigue des appels p95", "gridPos": {"x": 12, "y": 46, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(chatisen_call_jitter_milliseconds_bucket[5m])))", "legendFormat": "", "refId": "A"}]},
    {"id": 13, "type": "timeseries", "title": "Débit média reçu p95", "gridPos": {"x": 0, "y": 54, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "Kbits"}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(chatisen_call_bitrate_kilobits_per_second_bucket[5m])))", "legendFormat": "", "refId": "A"}]},
    {"id": 14, "type": "timeseries", "title": "Pertes de paquets média", "gridPos": {"x": 12, "y": 54, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}, "targets": [{"expr": "100 * sum(rate(chatisen_call_packets_total{result=\"lost\"}[5m])) / sum(rate(chatisen_call_packets_total[5m]))", "legendFormat": "", "refId": "A"}]},
    {"id": 15, "type": "timeseries", "title": "Mesures de qualité par type de candidat", "gridPos": {"x": 0, "y": 62, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "sum by (candidate_type) (rate(chatisen_call_quality_samples_total[5m]))", "legendFormat": "{{candidate_type}}", "refId": "A"}]},
    {"id": 16, "type": "timeseries", "title": "CPU utilisé", "gridPos": {"x": 12, "y": 62, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}, "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "{{instance}}", "refId": "A"}]},
    {"id": 17, "type": "timeseries", "title": "Mémoire disponible", "gridPos": {"x": 0, "y": 70, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "node_memory_MemAvailable_bytes", "legendFormat": "{{instance}}", "refId": "A"}]}
  ]
}
