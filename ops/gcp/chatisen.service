[Unit]
Description=ChatISEN standalone demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatisen
Group=chatisen
WorkingDirectory=/opt/chatisen/app
EnvironmentFile=/etc/chatisen/chatisen.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=COOKIE_SECURE=true
Environment=CHATISEN_DATA_FILE=/var/lib/chatisen/chatisen.json
ExecStart=/opt/chatisen/runtime/node-v24.14.1-linux-x64/bin/node /opt/chatisen/app/apps/standalone/server.mjs
Restart=on-failure
RestartSec=3
StateDirectory=chatisen
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
