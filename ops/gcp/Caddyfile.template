CHATISEN_DOMAIN {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
    redir /architecture /architecture/ 308
    handle_path /architecture/* {
        @reader path_regexp ^/(index[.]html|lecteur[.]js|svg/[a-z0-9-]+[.]svg)?$
        handle @reader {
            root * /opt/chatisen/app/docs/architecture
            file_server
        }
        respond 404
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
