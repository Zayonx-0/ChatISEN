{
  "name": "chatisen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node apps/standalone/server.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/standalone.test.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "verify": "npm run typecheck && npm test",
    "study": "python analysis/study.py",
    "doctor": "node scripts/doctor.mjs",
    "up": "docker compose -f infra/compose/docker-compose.yml up -d --build",
    "down": "docker compose -f infra/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.9"
  }
}
