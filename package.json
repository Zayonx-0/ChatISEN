{
  "name": "chatisen",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "node apps/standalone/server.mjs",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node scripts/test.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "verify": "node scripts/verify.mjs",
    "study": "python analysis/study.py",
    "doctor": "node scripts/doctor.mjs",
    "up": "docker compose -f infra/compose/docker-compose.yml up -d --build",
    "down": "docker compose -f infra/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
